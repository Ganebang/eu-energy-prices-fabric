      "border": [{"show": true, "color": {"solid": {"color": "#DDE3EA"}}, "radius": 6}],
      "dropShadow": [{"show": false}],
      "padding": [{"top": 8, "bottom": 8, "left": 12, "right": 12}],
      "visualHeader": [{"show": false}],
      "title": [{"show": true, "fontColor": {"solid": {"color": "#0B2545"}}, "fontSize": 11, "fontFamily": "Segoe UI Semibold", "alignment": "left"}],
      "categoryAxis": [{"labelColor": {"solid": {"color": "#5B6B7C"}}, "fontSize": 9, "showAxisTitle": false, "gridlineShow": false}],
      "valueAxis": [{"labelColor": {"solid": {"color": "#5B6B7C"}}, "fontSize": 9, "showAxisTitle": false, "gridlineShow": true, "gridlineColor": {"solid": {"color": "#E6EBF0"}}, "gridlineStyle": "dotted"}],
      "legend": [{"show": true, "position": "Top", "showTitle": false, "labelColor": {"solid": {"color": "#5B6B7C"}}, "fontSize": 9}]
    }},
    "page": {"*": {
      "background": [{"color": {"solid": {"color": "#EEF2F6"}}, "transparency": 0}],
      "outspace": [{"color": {"solid": {"color": "#EEF2F6"}}, "transparency": 0}]
    }},
    "card": {"*": {
      "labels": [{"color": {"solid": {"color": "#0B2545"}}, "fontSize": 20, "fontFamily": "Segoe UI Semibold"}],
