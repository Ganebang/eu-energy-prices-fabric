      "title": [{"show": true, "fontColor": {"solid": {"color": "#5B6B7C"}}, "fontSize": 9, "fontFamily": "Segoe UI"}]
    }},
    "slicer": {"*": {
      "header": [{"show": false}],
      "items": [{"fontColor": {"solid": {"color": "#1F2A37"}}, "textSize": 10}],
      "title": [{"show": true, "fontColor": {"solid": {"color": "#5B6B7C"}}, "fontSize": 9, "fontFamily": "Segoe UI"}]
    }},
    "lineChart": {"*": {
      "lineStyles": [{"strokeWidth": 2, "showMarker": true, "markerSize": 4}]
    }},
    "tableEx": {"*": {
      "columnHeaders": [{"fontColor": {"solid": {"color": "#FFFFFF"}}, "backColor": {"solid": {"color": "#0B2545"}}, "fontSize": 9}],
      "values": [{"fontColorPrimary": {"solid": {"color": "#1F2A37"}}, "backColorPrimary": {"solid": {"color": "#FFFFFF"}}, "fontColorSecondary": {"solid": {"color": "#1F2A37"}}, "backColorSecondary": {"solid": {"color": "#F5F7FA"}}, "fontSize": 9}],
      "grid": [{"gridHorizontal": false, "gridVertical": false}]
    }},
    "textbox": {"*": {
