table fact_daily_battery
	lineageTag: 83df8f6f-caae-4cc7-8136-37fd42727e24

	/// Somme des gains journaliers (1 cycle / jour, prix de gros)
	measure 'Gain d''arbitrage (€)' = SUM ( fact_daily_battery[arbitrage_gain_eur] )
		formatString: #,0.00 €
		displayFolder: 5. Batterie
		lineageTag: 909eb30f-7def-4142-8307-8c695f7bc889

	measure 'Gain moyen par jour (€)' = AVERAGEX ( VALUES ( fact_daily_battery[date_key] ), CALCULATE ( SUM ( fact_daily_battery[arbitrage_gain_eur] ) ) )
		formatString: #,0.00 €
		displayFolder: 5. Batterie
		lineageTag: 624bad8c-68d7-4d05-8af0-78cd9245ee4b

	/// Extrapolation sur 365 jours
	measure 'Gain annualisé (€/an)' = [Gain moyen par jour (€)] * 365
		formatString: #,0 €
		displayFolder: 5. Batterie
		lineageTag: 7ddbe6f3-5b4a-4889-a0e8-1c7c1dd6302e

	measure 'Spread charge/décharge (c€/kWh)' = AVERAGE ( fact_daily_battery[avg_discharge_price_ct_kwh] ) - AVERAGE ( fact_daily_battery[avg_charge_price_ct_kwh] )
		formatString: 0.00
		displayFolder: 5. Batterie
		lineageTag: d00c54a1-bb61-4d59-a5bc-1d5c9eab96f1

	column zone_code
		dataType: string
		isHidden
