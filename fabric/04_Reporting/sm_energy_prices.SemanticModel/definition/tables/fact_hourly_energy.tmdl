table fact_hourly_energy
	lineageTag: 104397a3-61bd-4cf3-ba5e-b2e6d291ac6e

	/// Moyenne des prix horaires (grain heure)
	measure 'Prix horaire moyen (c€/kWh)' = AVERAGE ( fact_hourly_energy[avg_price_ct_kwh] )
		formatString: 0.00
		displayFolder: 1. Prix
		lineageTag: 37566cf0-0e1d-4695-abf5-1ab99534cade

	measure 'Solaire moyen (MW)' = AVERAGE ( fact_hourly_energy[solar_mw] )
		formatString: #,0
		displayFolder: 3. Production & météo
		lineageTag: 8275cc30-9fd3-4a13-b975-8a5a6a1e75b7

	/// Terrestre + en mer
	measure 'Éolien moyen (MW)' = AVERAGEX ( fact_hourly_energy, COALESCE ( fact_hourly_energy[wind_onshore_mw], 0 ) + COALESCE ( fact_hourly_energy[wind_offshore_mw], 0 ) )
		formatString: #,0
		displayFolder: 3. Production & météo
		lineageTag: dbded04b-107c-4d95-91d1-d1ff0ee714d9

	measure 'Consommation moyenne (MW)' = AVERAGE ( fact_hourly_energy[load_mw] )
		formatString: #,0
		displayFolder: 3. Production & météo
		lineageTag: 6e5a52ee-5d39-4269-b9fa-9c02b0b881ea

	/// Part de la charge couverte par les renouvelables
	measure 'Part renouvelable %' = DIVIDE ( AVERAGE ( fact_hourly_energy[renewable_share_pct] ), 100 )
		formatString: 0.0%
		displayFolder: 3. Production & météo
		lineageTag: 4465cb3a-78fe-4c60-8dc0-af3d81ff5a87

	measure 'Température moyenne (°C)' = AVERAGE ( fact_hourly_energy[temperature_c] )
		formatString: 0.0
		displayFolder: 3. Production & météo
		lineageTag: 1e179ffd-df41-4eab-98b4-79d6b7180426

	measure 'Vent moyen 100 m (km/h)' = AVERAGE ( fact_hourly_energy[wind_speed_100m_kmh] )
		formatString: 0.0
		displayFolder: 3. Production & météo
		lineageTag: 52578c88-1f4c-4a56-a106-a206ccbb16a1

	/// Coefficient de Pearson (-1 à 1) entre vitesse du vent et prix horaire
	measure 'Corrélation prix ~ vent' = ```
			
			VAR observations =
			    FILTER ( fact_hourly_energy,
			        NOT ISBLANK ( fact_hourly_energy[wind_speed_100m_kmh] ) && NOT ISBLANK ( fact_hourly_energy[avg_price_ct_kwh] ) )
			VAR mean_x = AVERAGEX ( observations, fact_hourly_energy[wind_speed_100m_kmh] )
			VAR mean_y = AVERAGEX ( observations, fact_hourly_energy[avg_price_ct_kwh] )
			VAR covariance = SUMX ( observations, ( fact_hourly_energy[wind_speed_100m_kmh] - mean_x ) * ( fact_hourly_energy[avg_price_ct_kwh] - mean_y ) )
			VAR spread_x = SQRT ( SUMX ( observations, ( fact_hourly_energy[wind_speed_100m_kmh] - mean_x ) ^ 2 ) )
			VAR spread_y = SQRT ( SUMX ( observations, ( fact_hourly_energy[avg_price_ct_kwh] - mean_y ) ^ 2 ) )
			RETURN DIVIDE ( covariance, spread_x * spread_y )
			
			```
		formatString: 0.00
		displayFolder: 4. Analyse
		lineageTag: 0780ee44-cd26-4b72-bda7-a528bb15cdb6

	/// Coefficient de Pearson entre rayonnement solaire et prix horaire
	measure 'Corrélation prix ~ ensoleillement' = ```
			
			VAR observations =
			    FILTER ( fact_hourly_energy,
			        NOT ISBLANK ( fact_hourly_energy[shortwave_radiation_wm2] ) && NOT ISBLANK ( fact_hourly_energy[avg_price_ct_kwh] ) )
			VAR mean_x = AVERAGEX ( observations, fact_hourly_energy[shortwave_radiation_wm2] )
			VAR mean_y = AVERAGEX ( observations, fact_hourly_energy[avg_price_ct_kwh] )
			VAR covariance = SUMX ( observations, ( fact_hourly_energy[shortwave_radiation_wm2] - mean_x ) * ( fact_hourly_energy[avg_price_ct_kwh] - mean_y ) )
			VAR spread_x = SQRT ( SUMX ( observations, ( fact_hourly_energy[shortwave_radiation_wm2] - mean_x ) ^ 2 ) )
			VAR spread_y = SQRT ( SUMX ( observations, ( fact_hourly_energy[avg_price_ct_kwh] - mean_y ) ^ 2 ) )
			RETURN DIVIDE ( covariance, spread_x * spread_y )
			
			```
		formatString: 0.00
		displayFolder: 4. Analyse
		lineageTag: a8480645-3955-499f-b103-790e0d3f2b33

	measure 'Corrélation prix ~ part renouvelable' = ```
			
			VAR observations =
			    FILTER ( fact_hourly_energy,
			        NOT ISBLANK ( fact_hourly_energy[renewable_share_pct] ) && NOT ISBLANK ( fact_hourly_energy[avg_price_ct_kwh] ) )
			VAR mean_x = AVERAGEX ( observations, fact_hourly_energy[renewable_share_pct] )
			VAR mean_y = AVERAGEX ( observations, fact_hourly_energy[avg_price_ct_kwh] )
			VAR covariance = SUMX ( observations, ( fact_hourly_energy[renewable_share_pct] - mean_x ) * ( fact_hourly_energy[avg_price_ct_kwh] - mean_y ) )
			VAR spread_x = SQRT ( SUMX ( observations, ( fact_hourly_energy[renewable_share_pct] - mean_x ) ^ 2 ) )
			VAR spread_y = SQRT ( SUMX ( observations, ( fact_hourly_energy[avg_price_ct_kwh] - mean_y ) ^ 2 ) )
			RETURN DIVIDE ( covariance, spread_x * spread_y )
			
			```
		formatString: 0.00
		displayFolder: 4. Analyse
		lineageTag: fd0f1c78-1a84-42a7-8963-5ddad4bed2bb

