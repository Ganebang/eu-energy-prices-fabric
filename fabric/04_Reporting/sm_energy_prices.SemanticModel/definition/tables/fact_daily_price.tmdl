table fact_daily_price
	lineageTag: eb410dc6-cc57-4219-ac5b-5333e7072c0a

	/// Écart-type intra-journalier moyen
	measure 'Volatilité moyenne (c€/kWh)' = AVERAGE ( fact_daily_price[stdev_price_ct_kwh] )
		formatString: 0.00
		displayFolder: 1. Prix
		lineageTag: f84dc529-674d-41f1-b0a4-e45af69cbaf9

	measure 'Jours fériés' = CALCULATE ( COUNTROWS ( fact_daily_price ), fact_daily_price[is_public_holiday] = TRUE () )
		formatString: 0
		displayFolder: 1. Prix
		lineageTag: 6d363363-7983-4ba6-be29-90093cc187f3

