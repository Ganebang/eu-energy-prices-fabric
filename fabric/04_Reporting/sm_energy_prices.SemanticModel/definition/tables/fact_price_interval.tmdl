table fact_price_interval
	lineageTag: 76770f38-b92b-40f5-bff1-49478765fe3f

	/// Moyenne simple des prix day-ahead sur les intervalles filtrés
	measure 'Prix moyen (c€/kWh)' = AVERAGE ( fact_price_interval[price_ct_kwh] )
		formatString: 0.00
		displayFolder: 1. Prix
		lineageTag: 5b31e539-bcec-437f-8ec3-ea1724d351d1

	/// Prix le plus bas
	measure 'Prix min (c€/kWh)' = MIN ( fact_price_interval[price_ct_kwh] )
		formatString: 0.00
		displayFolder: 1. Prix
		lineageTag: a92552da-fc7c-4a25-bcf7-11e081da56dd

	/// Prix le plus haut
	measure 'Prix max (c€/kWh)' = MAX ( fact_price_interval[price_ct_kwh] )
		formatString: 0.00
		displayFolder: 1. Prix
		lineageTag: d16b85ba-740a-48ae-b4cb-788a7428fc7b

	/// Médiane, robuste aux pics
	measure 'Prix médian (c€/kWh)' = MEDIAN ( fact_price_interval[price_ct_kwh] )
		formatString: 0.00
		displayFolder: 1. Prix
		lineageTag: 8075be82-a99c-479f-b60c-e64f4d1608e6

	/// Écart max - min : potentiel de déplacement de consommation
	measure 'Amplitude (c€/kWh)' = [Prix max (c€/kWh)] - [Prix min (c€/kWh)]
		formatString: 0.00
		displayFolder: 1. Prix
		lineageTag: a8b4f38a-f1a8-4a09-bb62-9ab1d3d40321

	/// Pointe EPEX : 08h-20h
	measure 'Prix moyen pointe (c€/kWh)' = CALCULATE ( [Prix moyen (c€/kWh)], dim_time_of_day[is_peak_period] = TRUE () )
		formatString: 0.00
		displayFolder: 1. Prix
		lineageTag: 3f7a6b90-0c26-41bd-a0f9-a3b56f284fae

	measure 'Prix moyen hors pointe (c€/kWh)' = CALCULATE ( [Prix moyen (c€/kWh)], dim_time_of_day[is_peak_period] = FALSE () )
		formatString: 0.00
		displayFolder: 1. Prix
		lineageTag: 0b6e118e-9352-401a-9c8d-8463fa7c4000

	measure 'Prime de pointe %' = DIVIDE ( [Prix moyen pointe (c€/kWh)] - [Prix moyen hors pointe (c€/kWh)], [Prix moyen hors pointe (c€/kWh)] )
		formatString: 0.0%
		displayFolder: 1. Prix
		lineageTag: 487cdb51-6189-4b2a-9649-6eb8a02e2ccd

	/// Même périmètre, la veille
	measure 'Prix moyen J-1 (c€/kWh)' = CALCULATE ( [Prix moyen (c€/kWh)], DATEADD ( dim_date[calendar_date], -1, DAY ) )
		formatString: 0.00
		displayFolder: 1. Prix
		lineageTag: f62daa61-bec9-4c2e-9f01-867cd9f8598f

	measure 'Variation vs J-1 %' = DIVIDE ( [Prix moyen (c€/kWh)] - [Prix moyen J-1 (c€/kWh)], ABS ( [Prix moyen J-1 (c€/kWh)] ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 1. Prix
		lineageTag: b4ccdda8-c8d2-49aa-8a41-fa03cc280dc0

	/// Durée cumulée pendant laquelle le prix était négatif
	measure 'Heures à prix négatif' = DIVIDE ( SUMX ( FILTER ( fact_price_interval, fact_price_interval[price_eur_mwh] < 0 ), fact_price_interval[resolution_minutes] ), 60 )
		formatString: #,0.0
		displayFolder: 1. Prix
		lineageTag: 48c2e83d-1a85-45bd-9162-18d1f41d6ba7

	/// Heures à prix négatif rapportées au nombre de zones sélectionnées
	measure 'Heures à prix négatif par zone' = AVERAGEX ( VALUES ( dim_bidding_zone[zone_code] ), [Heures à prix négatif] )
		formatString: #,0
		displayFolder: 1. Prix
		lineageTag: 6f0c1f0e-3a52-4c55-9a5e-2d7c9b1e4a01

	/// Heure de début de l'intervalle le moins cher. Calculée pour une seule zone et un seul jour, sinon "–".
	measure 'Créneau le moins cher' = ```
			IF (
			    HASONEVALUE ( dim_bidding_zone[zone_code] ) && HASONEVALUE ( dim_date[calendar_date] ),
			    VAR min_price = MIN ( fact_price_interval[price_ct_kwh] )
			    RETURN
			        MINX (
			            FILTER ( fact_price_interval, fact_price_interval[price_ct_kwh] = min_price ),
			            RELATED ( dim_time_of_day[time_label] )
			        ),
			    "–"
			)
			```
		displayFolder: 2. Conseil
		lineageTag: 8deb6407-228f-4462-9b1f-1adfdcea70da

	/// Heure de début de l'intervalle le plus cher. Calculée pour une seule zone et un seul jour, sinon "–".
	measure 'Créneau le plus cher' = ```
			IF (
			    HASONEVALUE ( dim_bidding_zone[zone_code] ) && HASONEVALUE ( dim_date[calendar_date] ),
			    VAR max_price = MAX ( fact_price_interval[price_ct_kwh] )
			    RETURN
			        MINX (
			            FILTER ( fact_price_interval, fact_price_interval[price_ct_kwh] = max_price ),
			            RELATED ( dim_time_of_day[time_label] )
			        ),
			    "–"
			)
			```
		displayFolder: 2. Conseil
		lineageTag: 15eb09c0-69ad-4409-9be8-31effcc3c42b

	/// Fraîcheur des données
	measure 'Prix disponibles jusqu''au' = FORMAT ( MAX ( fact_price_interval[interval_start_local] ), "dd/MM/yyyy HH:mm" )
		displayFolder: 9. Technique
		lineageTag: 11d5eecc-b185-4426-98a8-a669e2cba2d4

